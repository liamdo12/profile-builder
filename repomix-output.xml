            lineItem.setSection(line.getSection());
            lineItem.setSubSection(line.getSubSection());
            lineItem.setContent(line.getContent());
            lineItem.setSortOrder(sortOrder++);
            lineItem.setSourceItemId(line.getSourceItemId());
            lineItem.setMatchedRequirements(line.getMatchedRequirements());
            lineItem.setConfidence(line.getConfidence());
            lineItem.setRationale(line.getRationale());

            if (line.getSourceItemId() != null && itemToDocMap.containsKey(line.getSourceItemId())) {
                lineItem.setSourceDocumentId(itemToDocMap.get(line.getSourceItemId()));
            }

            lineEntities.add(lineItem);
        }
        // Store personal info as PERSONAL_INFO line items
        if (personalInfoOutput != null) {
            List<ResumeLineItem> personalInfoLines = buildPersonalInfoLines(
                    generatedResume.getId(), personalInfoOutput, sortOrder);
            lineEntities.addAll(personalInfoLines);
        }

        resumeLineItemRepository.saveAll(lineEntities);

        log.info("Generated resume id={} with {} lines", generatedResume.getId(), lineEntities.size());
        return toResponse(generatedResume, lineEntities);
    }

    public GeneratedResumeResponse getGeneratedResume(Long id) {
        GeneratedResume resume = generatedResumeRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Generated resume not found: " + id));
        List<ResumeLineItem> lines = resumeLineItemRepository.findByGeneratedResumeIdOrderBySortOrder(id);
        return toResponse(resume, lines);
    }

    public GeneratedResumeResponse.ResumeLineOutput updateLine(Long generatedResumeId, Long lineId, String content) {
        ResumeLineItem line = resumeLineItemRepository.findById(lineId)
                .orElseThrow(() -> new ResourceNotFoundException("Resume line not found: " + lineId));
        if (!line.getGeneratedResumeId().equals(generatedResumeId)) {
            throw new ResourceNotFoundException("Line does not belong to resume: " + generatedResumeId);
        }
        line.setContent(content);
        line = resumeLineItemRepository.save(line);
        return toLineOutput(line);
    }

    private List<ResumeLineItem> buildPersonalInfoLines(Long generatedResumeId,
                                                         PersonalInfoOutput info, int startSortOrder) {
        List<ResumeLineItem> lines = new ArrayList<>();
        Map<String, String> fields = new LinkedHashMap<>();
        fields.put("fullName", info.getFullName());
        fields.put("location", info.getLocation());
        fields.put("phone", info.getPhone());
        fields.put("email", info.getEmail());
        fields.put("linkedinUrl", info.getLinkedinUrl());
        fields.put("githubUrl", info.getGithubUrl());

        int order = startSortOrder;
        for (Map.Entry<String, String> entry : fields.entrySet()) {
            if (entry.getValue() != null && !entry.getValue().isBlank()) {
                ResumeLineItem lineItem = new ResumeLineItem();
                lineItem.setGeneratedResumeId(generatedResumeId);
                lineItem.setSection("PERSONAL_INFO");
                lineItem.setSubSection(entry.getKey());
                lineItem.setContent(entry.getValue());
                lineItem.setSortOrder(order++);
                lines.add(lineItem);
            }
        }
        return lines;
    }

    private GeneratedResumeResponse.PersonalInfo buildPersonalInfoFromLines(List<ResumeLineItem> personalInfoLines) {
        GeneratedResumeResponse.PersonalInfo info = new GeneratedResumeResponse.PersonalInfo();
        for (ResumeLineItem line : personalInfoLines) {
            switch (line.getSubSection()) {
                case "fullName" -> info.setFullName(line.getContent());
                case "location" -> info.setLocation(line.getContent());
                case "phone" -> info.setPhone(line.getContent());
                case "email" -> info.setEmail(line.getContent());
                case "linkedinUrl" -> info.setLinkedinUrl(line.getContent());
                case "githubUrl" -> info.setGithubUrl(line.getContent());
            }
        }
        return info;
    }

    private GeneratedResumeResponse toResponse(GeneratedResume resume, List<ResumeLineItem> lines) {
        // Separate personal info lines from content lines
        List<ResumeLineItem> personalInfoLines = lines.stream()
                .filter(l -> "PERSONAL_INFO".equals(l.getSection()))
                .toList();
        List<ResumeLineItem> contentLines = lines.stream()
                .filter(l -> !"PERSONAL_INFO".equals(l.getSection()))
                .toList();

        List<GeneratedResumeResponse.ResumeLineOutput> lineOutputs = contentLines.stream()
                .map(this::toLineOutput)
                .toList();

        GeneratedResumeResponse.PersonalInfo personalInfo = personalInfoLines.isEmpty()
                ? null : buildPersonalInfoFromLines(personalInfoLines);

        return new GeneratedResumeResponse(resume.getId(), resume.getTitle(), lineOutputs, personalInfo);
    }

    private GeneratedResumeResponse.ResumeLineOutput toLineOutput(ResumeLineItem line) {
        GeneratedResumeResponse.ResumeLineOutput output = new GeneratedResumeResponse.ResumeLineOutput();
        output.setId(line.getId());
        output.setSection(line.getSection());
        output.setSubSection(line.getSubSection());
        output.setContent(line.getContent());
        output.setSourceItemId(line.getSourceItemId());
        output.setMatchedRequirements(line.getMatchedRequirements());
        output.setConfidence(line.getConfidence() != null ? line.getConfidence() : 0.0);
        output.setRationale(line.getRationale());

        if (line.getSourceDocumentId() != null) {
            documentRepository.findById(line.getSourceDocumentId())
                    .ifPresent(doc -> output.setSourceDocumentName(doc.getOriginalName()));
        }

        return output;
    }
}
