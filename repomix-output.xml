package com.profilebuilder.service;

import com.profilebuilder.ai.agent.CompanyNameExtractorAgent;
import com.profilebuilder.ai.agent.CompanyResearchAgent;
import com.profilebuilder.model.dto.CompanyResearchResponse;
import com.profilebuilder.model.entity.JdAnalysis;
import com.profilebuilder.repository.JdAnalysisRepository;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.util.Optional;

/**
 * Orchestrates JD text extraction and company research via AI agent.
 */
@Service
public class CompanyResearchService {

    private static final Logger log = LoggerFactory.getLogger(CompanyResearchService.class);

    private final JdExtractionService jdExtractionService;
    private final CompanyNameExtractorAgent companyNameExtractorAgent;
    private final CompanyResearchAgent companyResearchAgent;
    private final JdAnalysisRepository jdAnalysisRepository;

    public CompanyResearchService(JdExtractionService jdExtractionService,
                                  CompanyNameExtractorAgent companyNameExtractorAgent,
                                  CompanyResearchAgent companyResearchAgent,
                                  JdAnalysisRepository jdAnalysisRepository) {
        this.jdExtractionService = jdExtractionService;
        this.companyNameExtractorAgent = companyNameExtractorAgent;
        this.companyResearchAgent = companyResearchAgent;
        this.jdAnalysisRepository = jdAnalysisRepository;
    }

    /**
     * Analyze a job description file: extract text, research the company, and persist the result.
     * Caches company-level data — if the same company was already researched, reuses it
     * and only extracts job-specific fields (jobTitle, keyRequirements) from the new JD.
     */
    public CompanyResearchResponse analyzeJobDescription(MultipartFile file) {
        log.info("Analyzing job description: {}", file.getOriginalFilename());

        String jdText = jdExtractionService.extractText(file);
        log.info("JD text extracted ({} chars), extracting company name", jdText.length());

        String companyName = companyNameExtractorAgent.extractCompanyName(jdText).trim();
        log.info("Extracted company name: '{}'", companyName);

        Optional<JdAnalysis> cached = jdAnalysisRepository.findFirstByCompanyNameIgnoreCase(companyName);

        CompanyResearchResponse response;
        if (cached.isPresent()) {
            log.info("Cache hit — reusing company data from JdAnalysis id={}", cached.get().getId());
            // Still call full research to get job-specific fields from this JD
            response = companyResearchAgent.researchCompany(jdText);
            // Merge: keep company-level data from cache, job-specific from fresh call
            JdAnalysis cachedEntity = cached.get();
            response.setIndustry(cachedEntity.getIndustry());
            response.setCompanySize(cachedEntity.getCompanySize());
            response.setDescription(cachedEntity.getDescription());
            response.setProducts(cachedEntity.getProducts());
            response.setTechStack(cachedEntity.getTechStack());
            response.setEngineeringBlog(cachedEntity.getEngineeringBlog());
            response.setYoutubeChannel(cachedEntity.getYoutubeChannel());
            response.setRecentNews(cachedEntity.getRecentNews());
            response.setKeyValues(cachedEntity.getKeyValues());
        } else {
            log.info("Cache miss — running full company research");
            response = companyResearchAgent.researchCompany(jdText);
        }

        log.info("Company research complete for: {}", response.getCompanyName());

        JdAnalysis entity = toEntity(response);
        entity = jdAnalysisRepository.save(entity);
        response.setId(entity.getId());

        log.info("JD analysis persisted with id={}", entity.getId());
        return response;
    }

    public JdAnalysis getJdAnalysis(Long id) {
        return jdAnalysisRepository.findById(id)
                .orElseThrow(() -> new com.profilebuilder.exception.ResourceNotFoundException(
                        "JD Analysis not found with id: " + id));
    }

    public CompanyResearchResponse toResponse(JdAnalysis entity) {
        CompanyResearchResponse response = new CompanyResearchResponse();
        response.setId(entity.getId());
        response.setCompanyName(entity.getCompanyName());
        response.setIndustry(entity.getIndustry());
        response.setCompanySize(entity.getCompanySize());
        response.setDescription(entity.getDescription());
        response.setProducts(entity.getProducts());
        response.setTechStack(entity.getTechStack());
        response.setEngineeringBlog(entity.getEngineeringBlog());
        response.setYoutubeChannel(entity.getYoutubeChannel());
        response.setRecentNews(entity.getRecentNews());
        response.setKeyValues(entity.getKeyValues());
        response.setJobTitle(entity.getJobTitle());
        response.setKeyRequirements(entity.getKeyRequirements());
        return response;
    }

    private JdAnalysis toEntity(CompanyResearchResponse response) {
        JdAnalysis entity = new JdAnalysis();
        entity.setCompanyName(response.getCompanyName());
        entity.setIndustry(response.getIndustry());
        entity.setCompanySize(response.getCompanySize());
        entity.setDescription(response.getDescription());
        entity.setProducts(response.getProducts());
        entity.setTechStack(response.getTechStack());
        entity.setEngineeringBlog(response.getEngineeringBlog());
        entity.setYoutubeChannel(response.getYoutubeChannel());
        entity.setRecentNews(response.getRecentNews());
        entity.setKeyValues(response.getKeyValues());
        entity.setJobTitle(response.getJobTitle());
        entity.setKeyRequirements(response.getKeyRequirements());
        return entity;
    }
}
