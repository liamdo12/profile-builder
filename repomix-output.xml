package com.profilebuilder.service;

import dev.langchain4j.data.embedding.Embedding;
import dev.langchain4j.data.segment.TextSegment;
import dev.langchain4j.model.embedding.EmbeddingModel;
import dev.langchain4j.store.embedding.EmbeddingMatch;
import dev.langchain4j.store.embedding.EmbeddingSearchRequest;
import dev.langchain4j.store.embedding.EmbeddingStore;
import dev.langchain4j.store.embedding.filter.Filter;
import com.profilebuilder.model.entity.JdAnalysis;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import java.util.*;
import java.util.stream.Collectors;
import java.util.stream.Stream;

import static dev.langchain4j.store.embedding.filter.MetadataFilterBuilder.metadataKey;

@Service
public class ResumeRelevanceService {

    private static final Logger log = LoggerFactory.getLogger(ResumeRelevanceService.class);

    private static final List<String> SCORED_CATEGORIES = List.of("EXPERIENCE", "EDUCATION", "PROJECT");

    private final EmbeddingModel embeddingModel;
    private final EmbeddingStore<TextSegment> embeddingStore;

    public ResumeRelevanceService(EmbeddingModel embeddingModel,
                                  EmbeddingStore<TextSegment> embeddingStore) {
        this.embeddingModel = embeddingModel;
        this.embeddingStore = embeddingStore;
    }

    /**
     * For each scored section category (EXPERIENCE, EDUCATION, PROJECT),
     * selects the document whose items are most relevant to the JD.
     *
     * @return Map of category name → best documentId
     */
    public Map<String, Long> selectBestDocumentPerSection(JdAnalysis jdAnalysis,
                                                          List<Long> documentIds) {
        if (documentIds.size() <= 1) {
            Long docId = documentIds.get(0);
            log.info("Single document selected (id={}), skipping relevance scoring", docId);
            Map<String, Long> result = new HashMap<>();
            for (String category : SCORED_CATEGORIES) {
                result.put(category, docId);
            }
            return result;
        }

        Embedding jdEmbedding = buildJdEmbedding(jdAnalysis);

        Map<String, Long> bestPerSection = new HashMap<>();

        for (String category : SCORED_CATEGORIES) {
            Long bestDocId = null;
            double bestScore = -1.0;

            for (Long docId : documentIds) {
                double avgScore = scoreDocumentCategory(jdEmbedding, docId, category);

                log.info("  Document {} / {} → relevance score: {}", docId, category,
                        String.format("%.4f", avgScore));

                if (avgScore > bestScore) {
                    bestScore = avgScore;
                    bestDocId = docId;
                }
            }

            if (bestDocId != null) {
                bestPerSection.put(category, bestDocId);
                log.info("Selected {} from document {} (score: {})",
                        category, bestDocId, String.format("%.4f", bestScore));
            }
        }

        return bestPerSection;
    }

    /**
     * Builds an embedding from JD key fields (jobTitle, keyRequirements, techStack).
     * Public so ResumeOrchestrationService can reuse it for per-bullet confidence scoring.
     */
    public Embedding buildJdEmbedding(JdAnalysis jd) {
        String jdText = Stream.of(
                        jd.getJobTitle(),
                        jd.getKeyRequirements() != null ? String.join(", ", jd.getKeyRequirements()) : "",
                        jd.getTechStack() != null ? String.join(", ", jd.getTechStack()) : ""
                )
                .filter(s -> s != null && !s.isBlank())
                .collect(Collectors.joining(" | "));

        log.info("Built JD embedding text ({} chars): {}",
                jdText.length(), jdText.length() > 200 ? jdText.substring(0, 200) + "..." : jdText);

        return embeddingModel.embed(jdText).content();
    }

    private double scoreDocumentCategory(Embedding jdEmbedding, Long docId, String category) {
        Filter filter = metadataKey("documentId").isEqualTo(docId.toString())
                .and(metadataKey("category").isEqualTo(category));

        EmbeddingSearchRequest request = EmbeddingSearchRequest.builder()
                .queryEmbedding(jdEmbedding)
                .maxResults(50)
                .minScore(0.0)
                .filter(filter)
                .build();

        List<EmbeddingMatch<TextSegment>> matches = embeddingStore.search(request).matches();

        return matches.stream()
                .mapToDouble(EmbeddingMatch::score)
                .average()
                .orElse(0.0);
    }
}
