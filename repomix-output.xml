import { useState } from 'react'
import type { ResumeLineOutput } from '@/types/resume'
import type { GroupedSection, SubSectionParts } from '@/components/resume/resume-utils'
import { highlightText } from '@/components/resume/resume-utils'

interface ResumeSectionRendererProps {
  section: string
  subGroups: GroupedSection['subGroups']
  selectedLine: ResumeLineOutput | null
  onLineClick: (line: ResumeLineOutput) => void
  onLineEdit: (lineId: number, content: string) => void
  techTerms: Set<string>
}

type SubGroup = { subSection: string | null; parsed: SubSectionParts; lines: ResumeLineOutput[] }

export function ResumeSectionRenderer({
  section, subGroups, selectedLine, onLineClick, onLineEdit, techTerms,
}: ResumeSectionRendererProps) {
  const [editingId, setEditingId] = useState<number | null>(null)
  const [editValue, setEditValue] = useState('')

  const startEdit = (line: ResumeLineOutput) => {
    setEditingId(line.id)
    setEditValue(line.content)
  }

  const commitEdit = (lineId: number) => {
    if (editValue.trim()) {
      onLineEdit(lineId, editValue)
    }
    setEditingId(null)
  }

  const renderEditableText = (line: ResumeLineOutput, highlighted: boolean) => {
    if (editingId === line.id) {
      return (
        <input
          autoFocus
          className="w-full bg-transparent outline-none border-b border-primary"
          value={editValue}
          onChange={(e) => setEditValue(e.target.value)}
          onBlur={() => commitEdit(line.id)}
          onKeyDown={(e) => {
            if (e.key === 'Enter') commitEdit(line.id)
            if (e.key === 'Escape') setEditingId(null)
          }}
        />
      )
    }
    return (
      <span onDoubleClick={() => startEdit(line)}>
        {highlighted ? highlightText(line.content, techTerms) : line.content}
      </span>
    )
  }

  const renderEducation = (sg: SubGroup, i: number) => (
    <div key={i} className="resume-entry">
      {sg.subSection && (
        <>
          <div className="resume-entry-header-row">
            <span className="resume-entry-title">{sg.parsed.primary}</span>
            {sg.parsed.location && <span className="resume-entry-location">{sg.parsed.location}</span>}
          </div>
          <div className="resume-entry-header-row">
            <span className="resume-entry-subtitle">{sg.parsed.secondary}</span>
            {sg.parsed.date && <span className="resume-entry-date">{sg.parsed.date}</span>}
          </div>
        </>
      )}
      {sg.lines.map(line => line.content?.trim() && (
        <div
          key={line.id}
          className={`resume-education-detail ${selectedLine?.id === line.id ? 'selected' : ''}`}
          onClick={() => onLineClick(line)}
        >
          {renderEditableText(line, false)}
        </div>
      ))}
    </div>
  )

  const renderExperience = (sg: SubGroup, i: number) => (
    <div key={i} className="resume-entry">
      {sg.subSection && (
        <>
          <div className="resume-entry-header">
            <span className="resume-entry-title">{sg.parsed.primary}</span>
            {sg.parsed.date && <span className="resume-entry-date">{sg.parsed.date}</span>}
          </div>
          {sg.parsed.secondary && <div className="resume-entry-subtitle">{sg.parsed.secondary}</div>}
        </>
      )}
      <ul className="resume-bullets">
        {sg.lines.map(line => (
          <li
            key={line.id}
            className={`resume-bullet ${selectedLine?.id === line.id ? 'selected' : ''}`}
            onClick={() => onLineClick(line)}
          >
            {renderEditableText(line, true)}
          </li>
        ))}
      </ul>
    </div>
  )

  const renderProjects = (sg: SubGroup, i: number) => (
    <div key={i} className="resume-entry">
      {sg.subSection && (
        <div className="resume-entry-header">
          <span className="resume-entry-title">{sg.parsed.primary}</span>
          {sg.parsed.date && <span className="resume-entry-date">{sg.parsed.date}</span>}
        </div>
      )}
      <ul className="resume-bullets">
        {sg.lines.map(line => (
          <li
            key={line.id}
            className={`resume-bullet ${selectedLine?.id === line.id ? 'selected' : ''}`}
            onClick={() => onLineClick(line)}
          >
            {renderEditableText(line, true)}
          </li>
        ))}
      </ul>
    </div>
  )

  const renderSkills = (sg: SubGroup, i: number) => (
    <div
      key={i}
      className={`resume-skill-line ${selectedLine && sg.lines.some(l => l.id === selectedLine.id) ? 'selected' : ''}`}
      onClick={() => sg.lines[0] && onLineClick(sg.lines[0])}
    >
      {sg.subSection && <span className="resume-skill-category">{sg.parsed.primary}: </span>}
      {sg.lines.map(l => l.content).join(', ')}
    </div>
  )

  switch (section) {
    case 'EDUCATION': return <>{subGroups.map((sg, i) => renderEducation(sg, i))}</>
    case 'EXPERIENCE': return <>{subGroups.map((sg, i) => renderExperience(sg, i))}</>
    case 'PROJECTS': return <>{subGroups.map((sg, i) => renderProjects(sg, i))}</>
    case 'SKILLS': return <>{subGroups.map((sg, i) => renderSkills(sg, i))}</>
    default: return <>{subGroups.map((sg, i) => renderExperience(sg, i))}</>
  }
}
