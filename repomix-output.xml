import axios from 'axios';
import { API_BASE_URL } from '../config';
import type {
    CompanyResearchResponse,
    GeneratedResumeResponse,
    ParseResumeResponse,
    ResumeLineOutput,
} from '../types/resume';

const api = axios.create({
    baseURL: API_BASE_URL,
    timeout: 120000,
});

export async function analyzeJobDescription(file: File): Promise<CompanyResearchResponse> {
    const formData = new FormData();
    formData.append('file', file);
    const { data } = await api.post<CompanyResearchResponse>('/resume/analyze-jd', formData);
    return data;
}

export async function getJdAnalysis(id: number): Promise<CompanyResearchResponse> {
    const { data } = await api.get<CompanyResearchResponse>(`/resume/jd-analyses/${id}`);
    return data;
}

export async function parseResumes(documentIds: number[]): Promise<ParseResumeResponse> {
    const { data } = await api.post<ParseResumeResponse>('/resume/parse', { documentIds });
    return data;
}

export async function generateResume(
    jdAnalysisId: number,
    documentIds: number[],
): Promise<GeneratedResumeResponse> {
    const { data } = await api.post<GeneratedResumeResponse>('/resume/generate', {
        jdAnalysisId,
        documentIds,
    });
    return data;
}

export async function getGeneratedResume(id: number): Promise<GeneratedResumeResponse> {
    const { data } = await api.get<GeneratedResumeResponse>(`/resume/generated/${id}`);
    return data;
}

export async function updateResumeLine(
    generatedResumeId: number,
    lineId: number,
    content: string,
): Promise<ResumeLineOutput> {
    const { data } = await api.put<ResumeLineOutput>(
        `/resume/generated/${generatedResumeId}/lines/${lineId}`,
        { content },
    );
    return data;
}
</file>

