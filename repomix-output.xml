package com.profilebuilder.service;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.profilebuilder.ai.agent.BulletWriterAgent;
import com.profilebuilder.ai.dto.BulletWriterOutput;
import com.profilebuilder.ai.dto.SectionManifest;
import com.profilebuilder.model.dto.GeneratedResumeResponse;
import com.profilebuilder.model.entity.JdAnalysis;
import com.profilebuilder.model.entity.ParsedResumeItem;
import dev.langchain4j.data.embedding.Embedding;
import dev.langchain4j.data.segment.TextSegment;
import dev.langchain4j.model.embedding.EmbeddingModel;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.stereotype.Service;

import com.profilebuilder.model.enums.ResumeItemCategory;

import java.util.*;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.ExecutorService;
import java.util.stream.Collectors;

@Service
public class ResumeOrchestrationService {

    private static final Logger log = LoggerFactory.getLogger(ResumeOrchestrationService.class);

    public record OrchestrationResult(List<GeneratedResumeResponse.AgentLine> lines) {}

    private final BulletWriterAgent bulletWriterAgent;
    private final ObjectMapper objectMapper;
    private final ResumeRelevanceService resumeRelevanceService;
    private final EmbeddingModel embeddingModel;
    private final ExecutorService bulletWriterExecutor;

    public ResumeOrchestrationService(BulletWriterAgent bulletWriterAgent,
                                       ObjectMapper objectMapper,
                                       ResumeRelevanceService resumeRelevanceService,
                                       EmbeddingModel embeddingModel,
                                       @Qualifier("bulletWriterExecutor") ExecutorService bulletWriterExecutor) {
        this.bulletWriterAgent = bulletWriterAgent;
        this.objectMapper = objectMapper;
        this.resumeRelevanceService = resumeRelevanceService;
        this.embeddingModel = embeddingModel;
        this.bulletWriterExecutor = bulletWriterExecutor;
    }

    public OrchestrationResult orchestrate(JdAnalysis jdAnalysis,
                                            List<ParsedResumeItem> allParsedItems) {
        // Step 0: Select best document per section and filter/deduplicate items
        List<ParsedResumeItem> filteredItems = filterItemsByRelevance(jdAnalysis, allParsedItems);

        // Step 1: Build section manifest programmatically from parsed item categories
        log.info("Step 1: Building section manifest from {} items", filteredItems.size());
        SectionManifest manifest = buildSectionManifest(filteredItems);
        log.info("Step 1 complete: {} sections identified", manifest.getSections().size());
        for (SectionManifest.SectionEntry se : manifest.getSections()) {
            log.info("  Section '{}': {} itemIds", se.getSection(),
                    se.getItemIds() != null ? se.getItemIds().size() : 0);
        }

        // Build item lookup
        Map<Long, ParsedResumeItem> itemMap = filteredItems.stream()
                .collect(Collectors.toMap(ParsedResumeItem::getId, item -> item));

        List<GeneratedResumeResponse.AgentLine> allLines = new ArrayList<>();

        // Phase 1: EDUCATION — programmatic (deterministic, no AI needed)
        log.info("Phase 1: Building education lines programmatically");
        List<GeneratedResumeResponse.AgentLine> educationLines = buildEducationLines(manifest, itemMap);
        allLines.addAll(educationLines);
        log.info("Phase 1 complete: {} education lines", educationLines.size());

        // Phase 2: EXPERIENCE + PROJECTS — per-entry parallel AI calls
        log.info("Phase 2: Per-entry parallel AI calls for Experience + Projects");
        List<GeneratedResumeResponse.AgentLine> aiLines = dispatchPerEntryBulletWriting(
                manifest, itemMap, jdAnalysis);
        allLines.addAll(aiLines);
        log.info("Phase 2 complete: {} AI lines", aiLines.size());

        // Phase 3: SKILLS — programmatic (deterministic, JD-sorted)
        log.info("Phase 3: Building skill lines programmatically");
        List<GeneratedResumeResponse.AgentLine> skillLines = buildSkillLines(manifest, itemMap, jdAnalysis);
        allLines.addAll(skillLines);
        log.info("Phase 3 complete: {} skill lines", skillLines.size());

        return new OrchestrationResult(allLines);
    }

    // ── Phase 2: Per-entry parallel AI dispatch ─────────────────────

    private List<GeneratedResumeResponse.AgentLine> dispatchPerEntryBulletWriting(
            SectionManifest manifest, Map<Long, ParsedResumeItem> itemMap, JdAnalysis jdAnalysis) {

        List<CompletableFuture<List<BulletWriterOutput.BulletLine>>> futures = new ArrayList<>();

        // Experience entries
        SectionManifest.SectionEntry expSection = findSection(manifest, "EXPERIENCE");
        if (expSection != null && expSection.getJobEntries() != null) {
            for (SectionManifest.JobEntry je : expSection.getJobEntries()) {
                List<ParsedResumeItem> jobItems = je.getItemIds().stream()
                        .map(itemMap::get).filter(Objects::nonNull).toList();
                String input = buildJobEntryInput(je, jobItems, jdAnalysis);
                futures.add(CompletableFuture.supplyAsync(
                        () -> safeRewriteEntry(input), bulletWriterExecutor));
            }
        }

        // Project entries
        SectionManifest.SectionEntry projSection = findSection(manifest, "PROJECTS");
        if (projSection != null && projSection.getProjectEntries() != null) {
            for (SectionManifest.ProjectEntry pe : projSection.getProjectEntries()) {
                List<ParsedResumeItem> projItems = pe.getItemIds().stream()
                        .map(itemMap::get).filter(Objects::nonNull).toList();
                String input = buildProjectEntryInput(pe, projItems, jdAnalysis);
                futures.add(CompletableFuture.supplyAsync(
                        () -> safeRewriteEntry(input), bulletWriterExecutor));
            }
        }

        if (futures.isEmpty()) {
            return List.of();
        }

        // Wait for all — each future handles its own errors gracefully
        CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).join();

        List<BulletWriterOutput.BulletLine> bulletLines = futures.stream()
                .flatMap(f -> f.join().stream())
                .toList();

        // Batch embed all bullet contents for confidence scoring (single API call)
        Embedding jdEmbedding = resumeRelevanceService.buildJdEmbedding(jdAnalysis);
        List<TextSegment> segments = bulletLines.stream()
                .map(bl -> TextSegment.from(bl.getContent() != null ? bl.getContent() : ""))
                .toList();
        List<Embedding> bulletEmbeddings = embeddingModel.embedAll(segments).content();

        // Map to AgentLine with deterministic metadata
        List<GeneratedResumeResponse.AgentLine> result = new ArrayList<>();
        for (int i = 0; i < bulletLines.size(); i++) {
            BulletWriterOutput.BulletLine bl = bulletLines.get(i);
            GeneratedResumeResponse.AgentLine line = new GeneratedResumeResponse.AgentLine();
            line.setSection(bl.getSection());
            line.setSubSection(bl.getSubSection());
            line.setContent(bl.getContent());
            line.setSourceItemId(bl.getSourceItemId());
            line.setMatchedRequirements(computeMatchedRequirements(bl.getContent(), jdAnalysis));
            line.setConfidence(cosineSimilarity(bulletEmbeddings.get(i).vector(), jdEmbedding.vector()));
            line.setRationale(null);
            result.add(line);
        }

        return result;
    }

    private SectionManifest.SectionEntry findSection(SectionManifest manifest, String sectionName) {
        return manifest.getSections().stream()
                .filter(s -> sectionName.equals(s.getSection()))
                .findFirst().orElse(null);
    }

    /**
     * Calls BulletWriterAgent with retry and null-safe lines extraction.
     * Returns empty list on failure so one bad entry doesn't crash the entire resume.
     */
    private List<BulletWriterOutput.BulletLine> safeRewriteEntry(String input) {
        try {
            return extractLines(bulletWriterAgent.rewriteEntry(input));
        } catch (Exception e) {
            log.warn("BulletWriter call failed, retrying once: {}", e.getMessage());
            try {
                return extractLines(bulletWriterAgent.rewriteEntry(input));
            } catch (Exception retryEx) {
                log.error("BulletWriter retry also failed, skipping entry: {}", retryEx.getMessage());
                return List.of();
            }
        }
    }

    private List<BulletWriterOutput.BulletLine> extractLines(BulletWriterOutput output) {
        if (output == null || output.getLines() == null) {
            return List.of();
        }
        return output.getLines();
    }

    // ── Per-entry input builders ────────────────────────────────────

    private String buildJobEntryInput(SectionManifest.JobEntry je,
                                       List<ParsedResumeItem> items, JdAnalysis jdAnalysis) {
        Map<String, Object> input = new LinkedHashMap<>();
        input.put("entryType", "JOB");

        Map<String, Object> header = new LinkedHashMap<>();
        header.put("jobTitle", je.getJobTitle());
        header.put("companyName", je.getCompanyName());
        header.put("dateRange", je.getDateRange());
        input.put("header", header);

        input.put("bullets", items.stream().map(item -> {
            Map<String, Object> m = new LinkedHashMap<>();
            m.put("id", item.getId());
            m.put("content", item.getContent());
            return m;
        }).toList());

        input.put("jd", buildSlimJdMap(jdAnalysis));
        return toJson(input);
    }

    private String buildProjectEntryInput(SectionManifest.ProjectEntry pe,
                                           List<ParsedResumeItem> items, JdAnalysis jdAnalysis) {
        Map<String, Object> input = new LinkedHashMap<>();
        input.put("entryType", "PROJECT");

        Map<String, Object> header = new LinkedHashMap<>();
        header.put("projectName", pe.getProjectName());
        header.put("dateRange", pe.getDateRange());
        input.put("header", header);

        input.put("bullets", items.stream().map(item -> {
            Map<String, Object> m = new LinkedHashMap<>();
            m.put("id", item.getId());
            m.put("content", item.getContent());
            return m;
        }).toList());

        input.put("jd", buildSlimJdMap(jdAnalysis));
        return toJson(input);
    }

    // ── Deterministic metadata computation ──────────────────────────

    private List<String> computeMatchedRequirements(String bulletContent, JdAnalysis jd) {
        if (bulletContent == null || bulletContent.isBlank()) {
            return List.of();
        }
        String contentLower = bulletContent.toLowerCase();
        List<String> matched = new ArrayList<>();

        // Check tech stack terms
        if (jd.getTechStack() != null) {
            for (String tech : jd.getTechStack()) {
                if (contentLower.contains(tech.toLowerCase())) {
                    matched.add(tech);
                }
            }
        }

        // Check key requirements terms
        if (jd.getKeyRequirements() != null) {
            for (String req : jd.getKeyRequirements()) {
                if (contentLower.contains(req.toLowerCase())) {
                    matched.add(req);
                }
            }
        }

        return matched;
    }

    private double cosineSimilarity(float[] a, float[] b) {
        double dot = 0.0, normA = 0.0, normB = 0.0;
        for (int i = 0; i < a.length; i++) {
            dot += a[i] * b[i];
            normA += a[i] * a[i];
            normB += b[i] * b[i];
        }
        double denom = Math.sqrt(normA) * Math.sqrt(normB);
        return denom == 0 ? 0.0 : dot / denom;
    }

    // ── Slim JD map (only fields needed for bullet writing) ─────────

    private Map<String, Object> buildSlimJdMap(JdAnalysis jd) {
        Map<String, Object> jdMap = new LinkedHashMap<>();
        jdMap.put("jobTitle", jd.getJobTitle());
        jdMap.put("techStack", jd.getTechStack());
        jdMap.put("keyRequirements", jd.getKeyRequirements());
        return jdMap;
    }

    // ── Education lines (deterministic) ─────────────────────────────

    private List<GeneratedResumeResponse.AgentLine> buildEducationLines(
            SectionManifest manifest, Map<Long, ParsedResumeItem> itemMap) {
        List<GeneratedResumeResponse.AgentLine> lines = new ArrayList<>();

        SectionManifest.SectionEntry eduSection = manifest.getSections().stream()
                .filter(s -> "EDUCATION".equals(s.getSection()))
                .findFirst().orElse(null);
        if (eduSection == null || eduSection.getEducationEntries() == null) {
            return lines;
        }

        for (SectionManifest.EducationEntry ee : eduSection.getEducationEntries()) {
            String subSection = String.join(" | ",
                    ee.getInstitution(), ee.getDegree(), ee.getLocation(), ee.getDateRange());

            String institution = ee.getInstitution().toLowerCase();
            String degree = ee.getDegree().toLowerCase();
            String content = ee.getItemIds().stream()
                    .map(itemMap::get)
                    .filter(Objects::nonNull)
                    .map(ParsedResumeItem::getContent)
                    .filter(c -> c != null && !c.isBlank())
                    .filter(c -> !c.toLowerCase().contains(institution)
                            && !c.toLowerCase().contains(degree))
                    .collect(Collectors.joining("; "));

            GeneratedResumeResponse.AgentLine line = new GeneratedResumeResponse.AgentLine();
            line.setSection("EDUCATION");
            line.setSubSection(subSection);
            line.setContent(content != null ? content : "");
            line.setSourceItemId(ee.getItemIds().isEmpty() ? null : ee.getItemIds().get(0));
            line.setMatchedRequirements(List.of());
            line.setConfidence(1.0);
            line.setRationale("Education entry passed through programmatically");
            lines.add(line);
        }
        return lines;
    }

    // ── Skill lines (deterministic, JD-sorted) ─────────────────────

    private List<GeneratedResumeResponse.AgentLine> buildSkillLines(
            SectionManifest manifest, Map<Long, ParsedResumeItem> itemMap, JdAnalysis jdAnalysis) {
        List<GeneratedResumeResponse.AgentLine> lines = new ArrayList<>();

        SectionManifest.SectionEntry skillSection = manifest.getSections().stream()
                .filter(s -> "SKILLS".equals(s.getSection()))
                .findFirst().orElse(null);
        if (skillSection == null || skillSection.getItemIds() == null) {
            return lines;
        }

        Set<String> techStackLower = new HashSet<>();
        if (jdAnalysis.getTechStack() != null) {
            for (String tech : jdAnalysis.getTechStack()) {
                techStackLower.add(tech.toLowerCase());
            }
        }

        List<ParsedResumeItem> skillItems = skillSection.getItemIds().stream()
                .map(itemMap::get)
                .filter(Objects::nonNull)
                .toList();

        LinkedHashMap<String, List<ParsedResumeItem>> grouped = skillItems.stream()
                .collect(Collectors.groupingBy(
                        item -> (item.getContext() == null || item.getContext().isBlank())
                                ? "Other" : item.getContext(),
                        LinkedHashMap::new,
                        Collectors.toList()));

        for (Map.Entry<String, List<ParsedResumeItem>> group : grouped.entrySet()) {
            String category = group.getKey();
            List<ParsedResumeItem> items = group.getValue();

            List<ParsedResumeItem> matching = new ArrayList<>();
            List<ParsedResumeItem> nonMatching = new ArrayList<>();
            List<String> matchedSkillNames = new ArrayList<>();

            for (ParsedResumeItem item : items) {
                if (techStackLower.contains(item.getContent().toLowerCase())) {
                    matching.add(item);
                    matchedSkillNames.add(item.getContent());
                } else {
                    nonMatching.add(item);
                }
            }

            List<ParsedResumeItem> sorted = new ArrayList<>(matching);
            sorted.addAll(nonMatching);

            String content = sorted.stream()
                    .map(ParsedResumeItem::getContent)
                    .collect(Collectors.joining(", "));

            GeneratedResumeResponse.AgentLine line = new GeneratedResumeResponse.AgentLine();
            line.setSection("SKILLS");
            line.setSubSection(category);
            line.setContent(content);
            line.setSourceItemId(items.get(0).getId());
            line.setMatchedRequirements(matchedSkillNames);
            line.setConfidence(0.9);
            line.setRationale("Skills grouped by original category, JD-matching skills prioritized");
            lines.add(line);
        }
        return lines;
    }

    // ── Item relevance filtering ────────────────────────────────────

    private List<ParsedResumeItem> filterItemsByRelevance(JdAnalysis jdAnalysis,
                                                            List<ParsedResumeItem> allParsedItems) {
        List<Long> documentIds = allParsedItems.stream()
                .map(ParsedResumeItem::getDocumentId)
                .distinct()
                .toList();

        log.info("Step 0: Selecting best document per section from {} documents", documentIds.size());
        Map<String, Long> bestPerSection =
                resumeRelevanceService.selectBestDocumentPerSection(jdAnalysis, documentIds);

        List<ParsedResumeItem> filtered = new ArrayList<>();

        for (ParsedResumeItem item : allParsedItems) {
            if (item.getCategory() == null) continue;

            String categoryName = item.getCategory().name();

            if (categoryName.equals("EXPERIENCE") || categoryName.equals("EDUCATION")
                    || categoryName.equals("PROJECT")) {
                Long bestDocId = bestPerSection.get(categoryName);
                if (bestDocId != null && bestDocId.equals(item.getDocumentId())) {
                    filtered.add(item);
                }
            } else if (categoryName.equals("SKILL")) {
                filtered.add(item);
            } else {
                filtered.add(item);
            }
        }

        // Deduplicate skills by content (case-insensitive)
        List<ParsedResumeItem> skills = filtered.stream()
                .filter(i -> i.getCategory() == ResumeItemCategory.SKILL)
                .toList();
        List<ParsedResumeItem> nonSkills = filtered.stream()
                .filter(i -> i.getCategory() != ResumeItemCategory.SKILL)
                .collect(Collectors.toCollection(ArrayList::new));

        Set<String> seen = new LinkedHashSet<>();
        List<ParsedResumeItem> dedupedSkills = new ArrayList<>();
        for (ParsedResumeItem skill : skills) {
            String key = skill.getContent().toLowerCase().trim();
            if (seen.add(key)) {
                dedupedSkills.add(skill);
            }
        }

        log.info("SKILL: merged {} items from {} documents -> {} unique",
                skills.size(), documentIds.size(), dedupedSkills.size());

        nonSkills.addAll(dedupedSkills);
        return nonSkills;
    }

    // ── Section manifest builder ────────────────────────────────────

    private SectionManifest buildSectionManifest(List<ParsedResumeItem> allParsedItems) {
        Map<String, List<ParsedResumeItem>> byCategory = allParsedItems.stream()
                .filter(item -> item.getCategory() != null)
                .filter(item -> {
                    String cat = item.getCategory().name();
                    return cat.equals("EXPERIENCE") || cat.equals("SKILL")
                            || cat.equals("EDUCATION") || cat.equals("PROJECT");
                })
                .collect(Collectors.groupingBy(
                        item -> item.getCategory().name(),
                        LinkedHashMap::new,
                        Collectors.toList()));

        List<SectionManifest.SectionEntry> sections = new ArrayList<>();

        if (byCategory.containsKey("EDUCATION")) {
            List<ParsedResumeItem> items = byCategory.get("EDUCATION");
            SectionManifest.SectionEntry entry = new SectionManifest.SectionEntry();
            entry.setSection("EDUCATION");
            entry.setItemIds(items.stream().map(ParsedResumeItem::getId).toList());
            entry.setEducationEntries(buildEducationEntries(items));
            sections.add(entry);
        }

        if (byCategory.containsKey("EXPERIENCE")) {
            List<ParsedResumeItem> items = byCategory.get("EXPERIENCE");
            SectionManifest.SectionEntry entry = new SectionManifest.SectionEntry();
            entry.setSection("EXPERIENCE");
            entry.setItemIds(items.stream().map(ParsedResumeItem::getId).toList());
            entry.setJobEntries(buildJobEntries(items));
            sections.add(entry);
        }

        if (byCategory.containsKey("PROJECT")) {
            List<ParsedResumeItem> items = byCategory.get("PROJECT");
            SectionManifest.SectionEntry entry = new SectionManifest.SectionEntry();
            entry.setSection("PROJECTS");
            entry.setItemIds(items.stream().map(ParsedResumeItem::getId).toList());
            entry.setProjectEntries(buildProjectEntries(items));
            sections.add(entry);
        }

        if (byCategory.containsKey("SKILL")) {
            List<ParsedResumeItem> items = byCategory.get("SKILL");
            SectionManifest.SectionEntry entry = new SectionManifest.SectionEntry();
            entry.setSection("SKILLS");
            entry.setItemIds(items.stream().map(ParsedResumeItem::getId).toList());
            sections.add(entry);
        }

        SectionManifest manifest = new SectionManifest();
        manifest.setSections(sections);
        return manifest;
    }

    private List<SectionManifest.JobEntry> buildJobEntries(List<ParsedResumeItem> items) {
        LinkedHashMap<String, List<ParsedResumeItem>> grouped = items.stream()
                .collect(Collectors.groupingBy(
                        item -> item.getContext() != null ? item.getContext() : "",
                        LinkedHashMap::new,
                        Collectors.toList()));

        List<SectionManifest.JobEntry> entries = new ArrayList<>();
        for (Map.Entry<String, List<ParsedResumeItem>> group : grouped.entrySet()) {
            String[] parts = group.getKey().split("\\|");
            SectionManifest.JobEntry je = new SectionManifest.JobEntry();
            je.setJobTitle(safePart(parts, 0));
            je.setCompanyName(safePart(parts, 1));
            je.setDateRange(safePart(parts, 2));
            je.setBulletCount(group.getValue().size());
            je.setItemIds(group.getValue().stream().map(ParsedResumeItem::getId).toList());
            entries.add(je);
        }
        return entries;
    }

    private List<SectionManifest.ProjectEntry> buildProjectEntries(List<ParsedResumeItem> items) {
        LinkedHashMap<String, List<ParsedResumeItem>> grouped = items.stream()
                .collect(Collectors.groupingBy(
                        item -> item.getContext() != null ? item.getContext() : "",
                        LinkedHashMap::new,
                        Collectors.toList()));

        List<SectionManifest.ProjectEntry> entries = new ArrayList<>();
        for (Map.Entry<String, List<ParsedResumeItem>> group : grouped.entrySet()) {
            String[] parts = group.getKey().split("\\|");
            SectionManifest.ProjectEntry pe = new SectionManifest.ProjectEntry();
            pe.setProjectName(safePart(parts, 0));
            pe.setDateRange(safePart(parts, 1));
            pe.setBulletCount(group.getValue().size());
            pe.setItemIds(group.getValue().stream().map(ParsedResumeItem::getId).toList());
            entries.add(pe);
        }
        return entries;
    }

    private List<SectionManifest.EducationEntry> buildEducationEntries(List<ParsedResumeItem> items) {
        LinkedHashMap<String, List<ParsedResumeItem>> grouped = items.stream()
                .collect(Collectors.groupingBy(
                        item -> item.getContext() != null ? item.getContext() : "",
                        LinkedHashMap::new,
                        Collectors.toList()));

        List<SectionManifest.EducationEntry> entries = new ArrayList<>();
        for (Map.Entry<String, List<ParsedResumeItem>> group : grouped.entrySet()) {
            String[] parts = group.getKey().split("\\|");
            SectionManifest.EducationEntry ee = new SectionManifest.EducationEntry();
            ee.setInstitution(safePart(parts, 0));
            ee.setDegree(safePart(parts, 1));
            ee.setLocation(safePart(parts, 2));
            ee.setDateRange(safePart(parts, 3));
            ee.setItemIds(group.getValue().stream().map(ParsedResumeItem::getId).toList());
            entries.add(ee);
        }
        return entries;
    }

    // ── Utilities ───────────────────────────────────────────────────

    private String safePart(String[] parts, int index) {
        if (parts == null || index >= parts.length) {
            return "";
        }
        return parts[index].trim();
    }

    private String toJson(Object obj) {
        try {
            return objectMapper.writeValueAsString(obj);
        } catch (JsonProcessingException e) {
            throw new RuntimeException("Failed to serialize AI input", e);
        }
    }
}
