import { useState, useEffect } from 'react'
import { useParams, useNavigate } from 'react-router-dom'
import { toast } from 'sonner'
import { Button } from '@/components/ui/button'
import { Badge } from '@/components/ui/badge'
import { DataTable } from '@/components/shared/data-table'
import type { Column } from '@/components/shared/data-table'
import { LoadingSpinner } from '@/components/shared/loading-spinner'
import { PageHeader } from '@/components/shared/page-header'
import { FileText } from 'lucide-react'
import { fetchDocuments } from '../api/documentApi'
import { getJdAnalysis, parseResumes } from '../api/resumeApi'
import type { DocumentUploadResponse } from '../types/document'
import type { CompanyResearchResponse } from '../types/resume'

const docColumns: Column<DocumentUploadResponse>[] = [
  {
    key: 'originalName',
    header: 'Name',
    render: (_, record) => (
      <span className="flex items-center gap-2">
        <FileText className="h-4 w-4" />
        {record.originalName as string}
      </span>
    ),
  },
  {
    key: 'fileType',
    header: 'Format',
    width: '100px',
    render: (val) => {
      const type = val as string
      return <Badge variant="outline">{type?.includes('pdf') ? 'PDF' : 'DOC'}</Badge>
    },
  },
  {
    key: 'createdAt',
    header: 'Uploaded',
    width: '180px',
    render: (val) =>
      new Date(val as string).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      }),
  },
]

export default function ResumeSelectionPage() {
  const { jdAnalysisId } = useParams<{ jdAnalysisId: string }>()
  const navigate = useNavigate()

  const [jdAnalysis, setJdAnalysis] = useState<CompanyResearchResponse | null>(null)
  const [documents, setDocuments] = useState<DocumentUploadResponse[]>([])
  const [selectedDocIds, setSelectedDocIds] = useState<number[]>([])
  const [loadingDocs, setLoadingDocs] = useState(false)
  const [parsing, setParsing] = useState(false)

  useEffect(() => {
    loadData()
  }, [])

  const loadData = async () => {
    setLoadingDocs(true)
    try {
      const [docs, jd] = await Promise.all([
        fetchDocuments('RESUME'),
        getJdAnalysis(Number(jdAnalysisId)),
      ])
      setDocuments(docs)
      setJdAnalysis(jd)
    } catch {
      toast.error('Failed to load data')
    } finally {
      setLoadingDocs(false)
    }
  }

  const handleParse = async () => {
    if (selectedDocIds.length === 0) {
      toast.warning('Please select at least one resume')
      return
    }
    setParsing(true)
    try {
      const parsedData = await parseResumes(selectedDocIds)
      navigate(`/confirm-parsed/${jdAnalysisId}`, {
        state: { parsedData, documentIds: selectedDocIds },
      })
    } catch {
      toast.error('Failed to parse resumes')
    } finally {
      setParsing(false)
    }
  }

  const subtitle = jdAnalysis
    ? `For: ${jdAnalysis.jobTitle} at ${jdAnalysis.companyName}`
    : undefined

  return (
    <div className="mx-auto max-w-full sm:max-w-4xl">
      <PageHeader title="Build Resume" subtitle={subtitle} />

      <DataTable
        columns={docColumns}
        data={documents}
        rowKey="id"
        loading={loadingDocs}
        emptyText="No resumes uploaded. Upload resumes first."
        rowSelection={{
          selectedKeys: selectedDocIds,
          onChange: (keys) => setSelectedDocIds(keys as number[]),
        }}
      />

      <Button
        className="w-full mt-6"
        size="lg"
        disabled={selectedDocIds.length === 0 || parsing}
        onClick={handleParse}
      >
        {parsing ? 'Parsing resumes...' : 'Review Parsed Data'}
      </Button>

      {parsing && <LoadingSpinner label="Parsing resumes with AI..." />}
    </div>
  )
}
