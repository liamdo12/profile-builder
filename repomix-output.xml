package com.profilebuilder.service;

import com.profilebuilder.ai.agent.CertificationParserAgent;
import com.profilebuilder.ai.agent.EducationParserAgent;
import com.profilebuilder.ai.agent.ExperienceParserAgent;
import com.profilebuilder.ai.agent.PersonalInfoAgent;
import com.profilebuilder.ai.agent.ProjectParserAgent;
import com.profilebuilder.ai.agent.SectionIdentifierAgent;
import com.profilebuilder.ai.agent.SkillParserAgent;
import com.profilebuilder.ai.agent.SummaryParserAgent;
import com.profilebuilder.ai.dto.PersonalInfoOutput;
import com.profilebuilder.ai.dto.ResumeSectionsOutput;
import com.profilebuilder.exception.ResourceNotFoundException;
import com.profilebuilder.model.dto.ParsedResumeResponse;
import com.profilebuilder.model.entity.Document;
import com.profilebuilder.model.entity.ParsedResumeItem;
import com.profilebuilder.model.enums.ResumeItemCategory;
import com.profilebuilder.repository.DocumentRepository;
import com.profilebuilder.repository.ParsedResumeItemRepository;
import dev.langchain4j.data.document.Metadata;
import dev.langchain4j.data.embedding.Embedding;
import dev.langchain4j.data.segment.TextSegment;
import dev.langchain4j.model.embedding.EmbeddingModel;
import dev.langchain4j.store.embedding.EmbeddingStore;
import jakarta.annotation.PreDestroy;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import java.nio.file.Path;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;

@Service
public class ResumeParsingService {

    private static final Logger log = LoggerFactory.getLogger(ResumeParsingService.class);

    private final DocumentRepository documentRepository;
    private final JdExtractionService jdExtractionService;
    private final PersonalInfoAgent personalInfoAgent;
    private final SectionIdentifierAgent sectionIdentifierAgent;
    private final SummaryParserAgent summaryParserAgent;
    private final ExperienceParserAgent experienceParserAgent;
    private final SkillParserAgent skillParserAgent;
    private final EducationParserAgent educationParserAgent;
    private final CertificationParserAgent certificationParserAgent;
    private final ProjectParserAgent projectParserAgent;
    private final ParsedResumeItemRepository parsedResumeItemRepository;
    private final EmbeddingModel embeddingModel;
    private final EmbeddingStore<TextSegment> embeddingStore;
    private final ExecutorService executor = Executors.newFixedThreadPool(6);

    public ResumeParsingService(DocumentRepository documentRepository,
                                JdExtractionService jdExtractionService,
                                PersonalInfoAgent personalInfoAgent,
                                SectionIdentifierAgent sectionIdentifierAgent,
                                SummaryParserAgent summaryParserAgent,
                                ExperienceParserAgent experienceParserAgent,
                                SkillParserAgent skillParserAgent,
                                EducationParserAgent educationParserAgent,
                                CertificationParserAgent certificationParserAgent,
                                ProjectParserAgent projectParserAgent,
                                ParsedResumeItemRepository parsedResumeItemRepository,
                                EmbeddingModel embeddingModel,
                                EmbeddingStore<TextSegment> embeddingStore) {
        this.documentRepository = documentRepository;
        this.jdExtractionService = jdExtractionService;
        this.personalInfoAgent = personalInfoAgent;
        this.sectionIdentifierAgent = sectionIdentifierAgent;
        this.summaryParserAgent = summaryParserAgent;
        this.experienceParserAgent = experienceParserAgent;
        this.skillParserAgent = skillParserAgent;
        this.educationParserAgent = educationParserAgent;
        this.certificationParserAgent = certificationParserAgent;
        this.projectParserAgent = projectParserAgent;
        this.parsedResumeItemRepository = parsedResumeItemRepository;
        this.embeddingModel = embeddingModel;
        this.embeddingStore = embeddingStore;
    }

    @PreDestroy
    void shutdownExecutor() {
        executor.shutdown();
        try {
            if (!executor.awaitTermination(30, TimeUnit.SECONDS)) {
                executor.shutdownNow();
            }
        } catch (InterruptedException e) {
            executor.shutdownNow();
            Thread.currentThread().interrupt();
        }
    }

    public ParsedResumeResponse parseResumes(List<Long> documentIds) {
        List<ParsedResumeResponse.ParsedResumeGroup> groups = new ArrayList<>();

        for (Long docId : documentIds) {
            Document doc = documentRepository.findById(docId)
                    .orElseThrow(() -> new ResourceNotFoundException("Document not found with id: " + docId));

            log.info("Parsing resume: {} (id={})", doc.getOriginalName(), doc.getId());

            String text = jdExtractionService.extractTextFromPath(Path.of(doc.getFilePath()));

            List<ParsedResumeItem> entities = new ArrayList<>();
            int sortOrder = 0;

            // 1. Personal info (unchanged — uses full text)
            PersonalInfoOutput personalInfo = personalInfoAgent.extractPersonalInfo(text);
            sortOrder = addPersonalInfoEntities(entities, personalInfo, docId, sortOrder);

            // 2. Phase 1 — Identify section boundaries
            String numberedText = addLineNumbers(text);
            ResumeSectionsOutput sectionsOutput = sectionIdentifierAgent.identifySections(numberedText);

            if (sectionsOutput != null && sectionsOutput.getSections() != null) {
                for (ResumeSectionsOutput.SectionBoundary section : sectionsOutput.getSections()) {
                    log.info("Identified section: {} ({}) lines {}-{}",
                            section.getCategory(), section.getHeading(),
                            section.getStartLine(), section.getEndLine());
                }
            }

            // 3. Phase 2 — Split text and parse each section (in parallel)
            Map<String, String> sectionTexts = splitTextBySections(text, sectionsOutput);

            record SectionParseResult(String category, ParsedResumeResponse.AgentOutput output) {}

            List<CompletableFuture<SectionParseResult>> futures = new ArrayList<>();
            List<String> sectionOrder = new ArrayList<>();
            for (Map.Entry<String, String> entry : sectionTexts.entrySet()) {
                String category = entry.getKey();
                String sectionText = entry.getValue();
                sectionOrder.add(category);
                log.info("Submitting {} section ({} chars) for parallel parsing", category, sectionText.length());

                futures.add(CompletableFuture.supplyAsync(() -> {
                    ParsedResumeResponse.AgentOutput agentOutput = parseSection(category, sectionText);
                    return new SectionParseResult(category, agentOutput);
                }, executor));
            }

            CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).join();

            for (int i = 0; i < futures.size(); i++) {
                SectionParseResult result = futures.get(i).join();
                sortOrder = parseCategory(result.output(), docId, entities, sortOrder);
                log.info("Parsed {} section for document id={}", result.category(), docId);
            }

            List<ParsedResumeItem> saved = parsedResumeItemRepository.saveAll(entities);
            log.info("Saved {} parsed items for document id={}", saved.size(), docId);

            storeEmbeddings(saved);

            List<ParsedResumeResponse.ParsedItem> items = saved.stream()
                    .map(e -> new ParsedResumeResponse.ParsedItem(
                            e.getId(), e.getCategory().name(), e.getContent(), e.getContext()))
                    .toList();

            groups.add(new ParsedResumeResponse.ParsedResumeGroup(docId, doc.getOriginalName(), items));
        }

        return new ParsedResumeResponse(groups);
    }

    String addLineNumbers(String text) {
        String[] lines = text.split("\n", -1);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < lines.length; i++) {
            sb.append(String.format("%4d | %s", i + 1, lines[i]));
            if (i < lines.length - 1) {
                sb.append("\n");
            }
        }
        return sb.toString();
    }

    Map<String, String> splitTextBySections(String text, ResumeSectionsOutput sectionsOutput) {
        Map<String, String> result = new LinkedHashMap<>();
        if (sectionsOutput == null || sectionsOutput.getSections() == null) {
            return result;
        }

        String[] lines = text.split("\n", -1);

        for (ResumeSectionsOutput.SectionBoundary section : sectionsOutput.getSections()) {
            int start = Math.max(0, section.getStartLine() - 1); // convert 1-indexed to 0-indexed
            int end = Math.min(lines.length, section.getEndLine()); // endLine is inclusive, so use as exclusive bound

            StringBuilder sb = new StringBuilder();
            for (int i = start; i < end; i++) {
                if (sb.length() > 0) {
                    sb.append("\n");
                }
                sb.append(lines[i]);
            }

            String category = section.getCategory();
            if (result.containsKey(category)) {
                // Multiple sections mapping to same category — append
                result.put(category, result.get(category) + "\n" + sb);
            } else {
                result.put(category, sb.toString());
            }
        }

        return result;
    }

    private ParsedResumeResponse.AgentOutput parseSection(String category, String sectionText) {
        return switch (category) {
            case "SUMMARY" -> summaryParserAgent.parseResume(sectionText);
            case "EXPERIENCE" -> experienceParserAgent.parseResume(sectionText);
            case "SKILL" -> skillParserAgent.parseResume(sectionText);
            case "EDUCATION" -> educationParserAgent.parseResume(sectionText);
            case "CERTIFICATION" -> certificationParserAgent.parseResume(sectionText);
            case "PROJECT" -> projectParserAgent.parseResume(sectionText);
            default -> {
                log.warn("Unknown section category: {}", category);
                yield null;
            }
        };
    }

    private int parseCategory(ParsedResumeResponse.AgentOutput agentOutput, Long docId,
                              List<ParsedResumeItem> entities, int sortOrder) {
        if (agentOutput == null || agentOutput.getItems() == null) {
            return sortOrder;
        }
        for (ParsedResumeResponse.AgentItem item : agentOutput.getItems()) {
            ParsedResumeItem entity = new ParsedResumeItem();
            entity.setDocumentId(docId);
            entity.setCategory(ResumeItemCategory.valueOf(item.getCategory()));
            entity.setContent(item.getContent());
            entity.setContext(item.getContext());
            entity.setSortOrder(sortOrder++);
            entities.add(entity);
        }
        return sortOrder;
    }

    private int addPersonalInfoEntities(List<ParsedResumeItem> entities, PersonalInfoOutput info, Long docId, int sortOrder) {
        String[][] fields = {
                {"fullName", info.getFullName()},
                {"email", info.getEmail()},
                {"phone", info.getPhone()},
                {"location", info.getLocation()},
                {"linkedinUrl", info.getLinkedinUrl()},
                {"githubUrl", info.getGithubUrl()}
        };
        for (String[] field : fields) {
            String context = field[0];
            String content = field[1];
            if (content != null && !content.isBlank()) {
                ParsedResumeItem entity = new ParsedResumeItem();
                entity.setDocumentId(docId);
                entity.setCategory(ResumeItemCategory.PERSONAL_INFO);
                entity.setContent(content);
                entity.setContext(context);
                entity.setSortOrder(sortOrder++);
                entities.add(entity);
            }
        }
        return sortOrder;
    }

    private void storeEmbeddings(List<ParsedResumeItem> items) {
        for (ParsedResumeItem item : items) {
            if (item.getCategory() == ResumeItemCategory.PERSONAL_INFO) {
                continue;
            }

            String textToEmbed = item.getContent();
            if (item.getContext() != null && !item.getContext().isBlank()) {
                textToEmbed = item.getContext() + " — " + textToEmbed;
            }

            Metadata metadata = new Metadata();
            metadata.put("parsedResumeItemId", item.getId().toString());
            metadata.put("documentId", item.getDocumentId().toString());
            metadata.put("category", item.getCategory().name());

            TextSegment segment = TextSegment.from(textToEmbed, metadata);
            Embedding embedding = embeddingModel.embed(segment).content();
            embeddingStore.add(embedding, segment);
        }
        log.info("Stored {} embeddings in pgvector", items.size());
    }
}
