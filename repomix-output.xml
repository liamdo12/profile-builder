import { useState } from 'react'
import { useParams, useNavigate, useLocation } from 'react-router-dom'
import { toast } from 'sonner'
import { Button } from '@/components/ui/button'
import { Badge } from '@/components/ui/badge'
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from '@/components/ui/accordion'
import { LoadingSpinner } from '@/components/shared/loading-spinner'
import { PageHeader } from '@/components/shared/page-header'
import { renderResumeGroup } from '@/components/resume/parsed-data-renderer'
import { Rocket, ArrowLeft } from 'lucide-react'
import { generateResume } from '../api/resumeApi'
import type { ParseResumeResponse } from '../types/resume'

interface LocationState {
  parsedData: ParseResumeResponse
  documentIds: number[]
}

export default function ConfirmParsedDataPage() {
  const { jdAnalysisId } = useParams<{ jdAnalysisId: string }>()
  const navigate = useNavigate()
  const location = useLocation()

  const state = location.state as LocationState | null
  const [generating, setGenerating] = useState(false)

  if (!state?.parsedData || !state?.documentIds) {
    navigate(`/build-resume/${jdAnalysisId}`, { replace: true })
    return null
  }

  const { parsedData, documentIds } = state

  const handleGenerate = async () => {
    setGenerating(true)
    try {
      const result = await generateResume(Number(jdAnalysisId), documentIds)
      toast.success('Resume generated!')
      navigate(`/resume-review/${result.id}`)
    } catch {
      toast.error('Failed to generate resume')
    } finally {
      setGenerating(false)
    }
  }

  const totalItems = parsedData.parsedResumes.reduce((sum, g) => sum + g.items.length, 0)

  return (
    <div className="mx-auto max-w-full sm:max-w-4xl">
      <PageHeader
        title="Confirm Parsed Data"
        subtitle={`${parsedData.parsedResumes.length} resume(s) parsed — ${totalItems} items extracted. Review before generating your tailored resume.`}
      />

      <Accordion
        type="multiple"
        defaultValue={parsedData.parsedResumes.map((g) => String(g.documentId))}
        className="mb-6"
      >
        {parsedData.parsedResumes.map((group) => (
          <AccordionItem key={group.documentId} value={String(group.documentId)}>
            <AccordionTrigger>
              <span className="flex items-center gap-2">
                {group.documentName}
                <Badge variant="outline">{group.items.length} items</Badge>
              </span>
            </AccordionTrigger>
            <AccordionContent>
              {renderResumeGroup(group)}
            </AccordionContent>
          </AccordionItem>
        ))}
      </Accordion>

      {generating && <LoadingSpinner label="Generating tailored resume with AI..." />}

      <div className="space-y-3 mt-6">
        <Button
          size="lg"
          className="w-full"
          disabled={generating}
          onClick={handleGenerate}
        >
          <Rocket className="h-4 w-4 mr-2" />
          {generating ? 'Generating tailored resume...' : 'Confirm & Generate'}
        </Button>
        <Button
          variant="outline"
          size="lg"
          className="w-full"
          disabled={generating}
          onClick={() => navigate(-1)}
        >
          <ArrowLeft className="h-4 w-4 mr-2" />
          Back
        </Button>
      </div>
    </div>
  )
}
