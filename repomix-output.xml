import { useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { toast } from 'sonner'
import { Button } from '@/components/ui/button'
import { Card, CardContent } from '@/components/ui/card'
import { FileUploadDropzone } from '@/components/shared/file-upload-dropzone'
import { LoadingSpinner } from '@/components/shared/loading-spinner'
import { PageHeader } from '@/components/shared/page-header'
import { JdAnalysisResultCards } from '@/components/resume/jd-analysis-result-cards'
import { Search, FilePlus } from 'lucide-react'
import { analyzeJobDescription } from '../api/resumeApi'
import type { CompanyResearchResponse } from '../types/resume'

export default function JdAnalysisPage() {
  const navigate = useNavigate()
  const [files, setFiles] = useState<File[]>([])
  const [loading, setLoading] = useState(false)
  const [result, setResult] = useState<CompanyResearchResponse | null>(null)

  const handleAnalyze = async () => {
    if (!files.length) {
      toast.warning('Please select a file')
      return
    }

    const rawFile = files[0]
    if (!rawFile) {
      toast.error('Unable to read the selected file. Please re-select it.')
      return
    }

    setLoading(true)
    setResult(null)

    try {
      const data = await analyzeJobDescription(rawFile)
      setResult(data)
      toast.success('Job description analyzed successfully')
    } catch (err: unknown) {
      const error = err as { response?: { data?: { message?: string } } }
      toast.error(error?.response?.data?.message || 'Analysis failed. Please try again.')
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="mx-auto max-w-full sm:max-w-3xl">
      <PageHeader
        title="Analyze Job Description"
        subtitle="Upload a job description (PDF or PNG) to get company intelligence and key requirements."
      />

      <Card className="mb-6">
        <CardContent className="pt-6 space-y-4">
          <FileUploadDropzone
            files={files}
            onFilesChange={setFiles}
            accept=".pdf,.png"
            maxFiles={1}
            disabled={loading}
            hint="Supports PDF and PNG — max 2MB"
          />
          <Button
            size="lg"
            className="w-full"
            disabled={!files.length || loading}
            onClick={handleAnalyze}
          >
            <Search className="h-4 w-4 mr-2" />
            {loading ? 'Analyzing job description...' : 'Analyze Job Description'}
          </Button>
        </CardContent>
      </Card>

      {loading && <LoadingSpinner label="Analyzing job description and researching company..." />}

      {result && (
        <div className="space-y-4">
          <Button
            size="lg"
            className="w-full"
            onClick={() => navigate(`/build-resume/${result.id}`)}
          >
            <FilePlus className="h-4 w-4 mr-2" />
            Build Resume for this Job
          </Button>
          <JdAnalysisResultCards result={result} />
        </div>
      )}
    </div>
  )
}
