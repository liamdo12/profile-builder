package com.profilebuilder.controller;

import com.profilebuilder.exception.InvalidFileException;
import com.profilebuilder.model.dto.*;
import com.profilebuilder.model.entity.JdAnalysis;
import com.profilebuilder.service.CompanyResearchService;
import com.profilebuilder.service.ResumeGenerationService;
import com.profilebuilder.service.ResumeParsingService;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.util.Set;

/**
 * REST controller for resume-related operations.
 */
@RestController
@RequestMapping("/api/resume")
public class ResumeController {

    private static final Set<String> ALLOWED_CONTENT_TYPES = Set.of(
            "application/pdf",
            "image/png"
    );

    private final CompanyResearchService companyResearchService;
    private final ResumeParsingService resumeParsingService;
    private final ResumeGenerationService resumeGenerationService;

    public ResumeController(CompanyResearchService companyResearchService,
                            ResumeParsingService resumeParsingService,
                            ResumeGenerationService resumeGenerationService) {
        this.companyResearchService = companyResearchService;
        this.resumeParsingService = resumeParsingService;
        this.resumeGenerationService = resumeGenerationService;
    }

    @PostMapping("/analyze-jd")
    public ResponseEntity<CompanyResearchResponse> analyzeJobDescription(
            @RequestParam("file") MultipartFile file) {
        validateFile(file);
        CompanyResearchResponse response = companyResearchService.analyzeJobDescription(file);
        return ResponseEntity.ok(response);
    }

    @GetMapping("/jd-analyses/{id}")
    public ResponseEntity<CompanyResearchResponse> getJdAnalysis(@PathVariable Long id) {
        JdAnalysis entity = companyResearchService.getJdAnalysis(id);
        return ResponseEntity.ok(companyResearchService.toResponse(entity));
    }

    @PostMapping("/parse")
    public ResponseEntity<ParsedResumeResponse> parseResumes(@RequestBody ParseResumeRequest request) {
        ParsedResumeResponse response = resumeParsingService.parseResumes(request.getDocumentIds());
        return ResponseEntity.ok(response);
    }

    @PostMapping("/generate")
    public ResponseEntity<GeneratedResumeResponse> generateResume(@RequestBody GenerateResumeRequest request) {
        GeneratedResumeResponse response = resumeGenerationService.generateResume(
                request.getJdAnalysisId(), request.getDocumentIds());
        return ResponseEntity.ok(response);
    }

    @GetMapping("/generated/{id}")
    public ResponseEntity<GeneratedResumeResponse> getGeneratedResume(@PathVariable Long id) {
        return ResponseEntity.ok(resumeGenerationService.getGeneratedResume(id));
    }

    @PutMapping("/generated/{id}/lines/{lineId}")
    public ResponseEntity<GeneratedResumeResponse.ResumeLineOutput> updateLine(
            @PathVariable Long id,
            @PathVariable Long lineId,
            @RequestBody UpdateLineRequest request) {
        return ResponseEntity.ok(resumeGenerationService.updateLine(id, lineId, request.getContent()));
    }

    private void validateFile(MultipartFile file) {
        if (file.isEmpty()) {
            throw new InvalidFileException("File is empty");
        }

        String contentType = file.getContentType();
        String fileName = file.getOriginalFilename();

        boolean validContentType = contentType != null && ALLOWED_CONTENT_TYPES.contains(contentType);
        boolean validExtension = fileName != null
                && (fileName.toLowerCase().endsWith(".pdf") || fileName.toLowerCase().endsWith(".png"));

        if (!validContentType && !validExtension) {
            throw new InvalidFileException(
                    "Invalid file type. Only PDF and PNG files are accepted.");
        }
    }
}
</file>

