<file path="backend/src/main/java/com/profilebuilder/service/ResumeGenerationService.java">
package com.profilebuilder.service;

import com.profilebuilder.exception.ResourceNotFoundException;
import com.profilebuilder.ai.dto.PersonalInfoOutput;
import com.profilebuilder.model.dto.GeneratedResumeResponse;
import com.profilebuilder.model.entity.*;
import com.profilebuilder.model.enums.ResumeItemCategory;
import com.profilebuilder.repository.*;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import java.util.*;
import java.util.stream.Collectors;

@Service
public class ResumeGenerationService {

    private static final Logger log = LoggerFactory.getLogger(ResumeGenerationService.class);

    private final JdAnalysisRepository jdAnalysisRepository;
    private final ParsedResumeItemRepository parsedResumeItemRepository;
    private final GeneratedResumeRepository generatedResumeRepository;
    private final ResumeLineItemRepository resumeLineItemRepository;
    private final DocumentRepository documentRepository;
    private final ResumeParsingService resumeParsingService;
    private final ResumeOrchestrationService resumeOrchestrationService;

    public ResumeGenerationService(JdAnalysisRepository jdAnalysisRepository,
                                   ParsedResumeItemRepository parsedResumeItemRepository,
                                   GeneratedResumeRepository generatedResumeRepository,
                                   ResumeLineItemRepository resumeLineItemRepository,
                                   DocumentRepository documentRepository,
                                   ResumeParsingService resumeParsingService,
                                   ResumeOrchestrationService resumeOrchestrationService) {
        this.jdAnalysisRepository = jdAnalysisRepository;
        this.parsedResumeItemRepository = parsedResumeItemRepository;
        this.generatedResumeRepository = generatedResumeRepository;
        this.resumeLineItemRepository = resumeLineItemRepository;
        this.documentRepository = documentRepository;
        this.resumeParsingService = resumeParsingService;
        this.resumeOrchestrationService = resumeOrchestrationService;
    }

    public GeneratedResumeResponse generateResume(Long jdAnalysisId, List<Long> documentIds) {
        JdAnalysis jdAnalysis = jdAnalysisRepository.findById(jdAnalysisId)
                .orElseThrow(() -> new ResourceNotFoundException("JD Analysis not found: " + jdAnalysisId));

        // Fetch all parsed items for given documents
        List<ParsedResumeItem> allParsedItems =
                parsedResumeItemRepository.findByDocumentIdInOrderByDocumentIdAscSortOrderAsc(documentIds);

        // If no parsed items exist, parse resumes first
        if (allParsedItems.isEmpty()) {
            log.info("No parsed items found for documents {}, parsing first", documentIds);
            resumeParsingService.parseResumes(documentIds);
            allParsedItems = parsedResumeItemRepository.findByDocumentIdInOrderByDocumentIdAscSortOrderAsc(documentIds);
        }

        log.info("Generating resume for JD analysis id={}, {} parsed items from {} documents",
                jdAnalysisId, allParsedItems.size(), documentIds.size());

        // Build personal info from stored PERSONAL_INFO parsed items
        PersonalInfoOutput personalInfoOutput = buildPersonalInfoFromParsedItems(allParsedItems);

        // Filter out PERSONAL_INFO items — orchestration only needs content sections
        List<ParsedResumeItem> contentItems = allParsedItems.stream()
                .filter(item -> item.getCategory() != ResumeItemCategory.PERSONAL_INFO)
                .toList();

        // Delegate to orchestration service
        ResumeOrchestrationService.OrchestrationResult result =
                resumeOrchestrationService.orchestrate(jdAnalysis, contentItems);
        List<GeneratedResumeResponse.AgentLine> agentLines = result.lines();

        // Persist the generated resume
        
        String title = personalInfoOutput != null && personalInfoOutput.getFullName() != null
                && !personalInfoOutput.getFullName().isBlank()
                ? personalInfoOutput.getFullName()
                : "Resume for " + jdAnalysis.getJobTitle() + " at " + jdAnalysis.getCompanyName();
        GeneratedResume generatedResume = new GeneratedResume();
        generatedResume.setJdAnalysisId(jdAnalysisId);
        generatedResume.setTitle(title);
        generatedResume = generatedResumeRepository.save(generatedResume);

        // Build a map of item ID -> document ID for provenance
        Map<Long, Long> itemToDocMap = allParsedItems.stream()
                .collect(Collectors.toMap(ParsedResumeItem::getId, ParsedResumeItem::getDocumentId));

        List<ResumeLineItem> lineEntities = new ArrayList<>();
        int sortOrder = 0;
        for (GeneratedResumeResponse.AgentLine line : agentLines) {
            ResumeLineItem lineItem = new ResumeLineItem();
            lineItem.setGeneratedResumeId(generatedResume.getId());
            lineItem.setSection(line.getSection());
            lineItem.setSubSection(line.getSubSection());
            lineItem.setContent(line.getContent());
            lineItem.setSortOrder(sortOrder++);
            lineItem.setSourceItemId(line.getSourceItemId());
            lineItem.setMatchedRequirements(line.getMatchedRequirements());
            lineItem.setConfidence(line.getConfidence());
            lineItem.setRationale(line.getRationale());

            if (line.getSourceItemId() != null && itemToDocMap.containsKey(line.getSourceItemId())) {
                lineItem.setSourceDocumentId(itemToDocMap.get(line.getSourceItemId()));
            }

            lineEntities.add(lineItem);
        }
        // Store personal info as PERSONAL_INFO line items
        if (personalInfoOutput != null) {
            List<ResumeLineItem> personalInfoLines = buildPersonalInfoLines(
                    generatedResume.getId(), personalInfoOutput, sortOrder);
            lineEntities.addAll(personalInfoLines);
        }

        resumeLineItemRepository.saveAll(lineEntities);

        log.info("Generated resume id={} with {} lines", generatedResume.getId(), lineEntities.size());
        return toResponse(generatedResume, lineEntities);
    }

    public GeneratedResumeResponse getGeneratedResume(Long id) {
        GeneratedResume resume = generatedResumeRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Generated resume not found: " + id));
        List<ResumeLineItem> lines = resumeLineItemRepository.findByGeneratedResumeIdOrderBySortOrder(id);
        return toResponse(resume, lines);
    }

    public GeneratedResumeResponse.ResumeLineOutput updateLine(Long generatedResumeId, Long lineId, String content) {
        ResumeLineItem line = resumeLineItemRepository.findById(lineId)
                .orElseThrow(() -> new ResourceNotFoundException("Resume line not found: " + lineId));
        if (!line.getGeneratedResumeId().equals(generatedResumeId)) {
            throw new ResourceNotFoundException("Line does not belong to resume: " + generatedResumeId);
        }
        line.setContent(content);
        line = resumeLineItemRepository.save(line);
        return toLineOutput(line);
    }

    private PersonalInfoOutput buildPersonalInfoFromParsedItems(List<ParsedResumeItem> items) {
        PersonalInfoOutput output = new PersonalInfoOutput();
        items.stream()
                .filter(item -> item.getCategory() == ResumeItemCategory.PERSONAL_INFO)
                .forEach(item -> {
                    String field = item.getContext();
                    String value = item.getContent();
                    if (field == null || value == null || value.isBlank()) return;
                    switch (field) {
                        case "fullName" -> output.setFullName(value);
                        case "email" -> output.setEmail(value);
                        case "location" -> output.setLocation(value);
                        case "phone" -> output.setPhone(value);
                        case "linkedinUrl" -> output.setLinkedinUrl(value);
                        case "githubUrl" -> output.setGithubUrl(value);
                    }
                });
        return output;
    }

    private List<ResumeLineItem> buildPersonalInfoLines(Long generatedResumeId,
                                                         PersonalInfoOutput info, int startSortOrder) {
        List<ResumeLineItem> lines = new ArrayList<>();
        Map<String, String> fields = new LinkedHashMap<>();
        fields.put("fullName", info.getFullName());
        fields.put("location", info.getLocation());
        fields.put("phone", info.getPhone());
        fields.put("email", info.getEmail());
        fields.put("linkedinUrl", info.getLinkedinUrl());
        fields.put("githubUrl", info.getGithubUrl());

        int order = startSortOrder;
        for (Map.Entry<String, String> entry : fields.entrySet()) {
            if (entry.getValue() != null && !entry.getValue().isBlank()) {
                ResumeLineItem lineItem = new ResumeLineItem();
                lineItem.setGeneratedResumeId(generatedResumeId);
                lineItem.setSection("PERSONAL_INFO");
                lineItem.setSubSection(entry.getKey());
                lineItem.setContent(entry.getValue());
                lineItem.setSortOrder(order++);
                lines.add(lineItem);
            }
        }
        return lines;
    }

    private GeneratedResumeResponse.PersonalInfo buildPersonalInfoFromLines(List<ResumeLineItem> personalInfoLines) {
        GeneratedResumeResponse.PersonalInfo info = new GeneratedResumeResponse.PersonalInfo();
        for (ResumeLineItem line : personalInfoLines) {
            switch (line.getSubSection()) {
                case "fullName" -> info.setFullName(line.getContent());
                case "location" -> info.setLocation(line.getContent());
                case "phone" -> info.setPhone(line.getContent());
                case "email" -> info.setEmail(line.getContent());
                case "linkedinUrl" -> info.setLinkedinUrl(line.getContent());
                case "githubUrl" -> info.setGithubUrl(line.getContent());
            }
        }
        return info;
    }

    private GeneratedResumeResponse toResponse(GeneratedResume resume, List<ResumeLineItem> lines) {
        // Separate personal info lines from content lines
        List<ResumeLineItem> personalInfoLines = lines.stream()
                .filter(l -> "PERSONAL_INFO".equals(l.getSection()))
                .toList();
        List<ResumeLineItem> contentLines = lines.stream()
                .filter(l -> !"PERSONAL_INFO".equals(l.getSection()))
                .toList();

        List<GeneratedResumeResponse.ResumeLineOutput> lineOutputs = contentLines.stream()
                .map(this::toLineOutput)
                .toList();

        GeneratedResumeResponse.PersonalInfo personalInfo = personalInfoLines.isEmpty()
                ? null : buildPersonalInfoFromLines(personalInfoLines);

        return new GeneratedResumeResponse(resume.getId(), resume.getTitle(), lineOutputs, personalInfo);
    }

    private GeneratedResumeResponse.ResumeLineOutput toLineOutput(ResumeLineItem line) {
        GeneratedResumeResponse.ResumeLineOutput output = new GeneratedResumeResponse.ResumeLineOutput();
        output.setId(line.getId());
        output.setSection(line.getSection());
        output.setSubSection(line.getSubSection());
        output.setContent(line.getContent());
        output.setSourceItemId(line.getSourceItemId());
        output.setMatchedRequirements(line.getMatchedRequirements());
        output.setConfidence(line.getConfidence() != null ? line.getConfidence() : 0.0);
        output.setRationale(line.getRationale());

        if (line.getSourceDocumentId() != null) {
            documentRepository.findById(line.getSourceDocumentId())
                    .ifPresent(doc -> output.setSourceDocumentName(doc.getOriginalName()));
        }

        return output;
    }
}
