<file path="frontend/src/components/resume/resume-utils.tsx">
import type React from 'react'
import type { ResumeLineOutput } from '@/types/resume'

export const sectionOrder = ['EDUCATION', 'EXPERIENCE', 'PROJECTS', 'SKILLS']

export const sectionLabels: Record<string, string> = {
  EDUCATION: 'Education',
  EXPERIENCE: 'Professional Work Experience',
  SKILLS: 'Technical Skills',
  PROJECTS: 'Projects',
}

export interface SubSectionParts {
  /** Institution / JobTitle / ProjectName / Category */
  primary: string
  /** Degree / Company / (empty) / (empty) */
  secondary: string
  /** Location (education only) */
  location: string
  /** Date range */
  date: string
}

export interface GroupedSection {
  section: string
  subGroups: {
    subSection: string | null
    parsed: SubSectionParts
    lines: ResumeLineOutput[]
  }[]
}

export function sanitizeField(value: string): string {
  return value.toLowerCase() === 'unknown' ? '' : value
}

export function parseSubSection(subSection: string | null): SubSectionParts {
  if (!subSection) return { primary: '', secondary: '', location: '', date: '' }
  const parts = subSection.split(' | ').map(s => s.trim())

  if (parts.length >= 4) {
    // Education: Institution | Degree | Location | Date
    return { primary: parts[0], secondary: parts[1], location: sanitizeField(parts[2]), date: sanitizeField(parts[3]) }
  }
  if (parts.length === 3) {
    // Experience: JobTitle | Company | Date
    return { primary: parts[0], secondary: parts[1], location: '', date: sanitizeField(parts[2]) }
  }
  if (parts.length === 2) {
    // Projects: ProjectName | Date
    return { primary: parts[0], secondary: '', location: '', date: sanitizeField(parts[1]) }
  }
  // Skills: Category
  return { primary: parts[0], secondary: '', location: '', date: '' }
}

export function parseDateForSort(dateStr: string): number {
  if (!dateStr) return 0
  // Split on en-dash or hyphen
  const parts = dateStr.split(/\s*[–-]\s*/)
  const end = parts[parts.length - 1].trim()
  if (end.toLowerCase() === 'present') return Date.now()
  const parsed = Date.parse(end)
  return isNaN(parsed) ? 0 : parsed
}

/**
 * Wraps matched tech terms and metric patterns in <strong> for visual highlight.
 * Returns React.ReactNode array since JSX is needed for <strong> elements.
 */
export function highlightText(text: string, terms: Set<string>): React.ReactNode {
  if (terms.size === 0 && !text) return text

  const techSorted = Array.from(terms).sort((a, b) => b.length - a.length)
  const techEscaped = techSorted.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))

  const metricPattern = '\\$[\\d,.]+[KMBkmb]?|\\d+(?:[.,]\\d+)?(?:\\s*[%xX]|\\s*\\+|[KMBkmb]+)'

  const patterns: string[] = []
  if (techEscaped.length > 0) patterns.push(`\\b(?:${techEscaped.join('|')})\\b`)
  patterns.push(metricPattern)

  const regex = new RegExp(`(${patterns.join('|')})`, 'gi')
  const splitParts = text.split(regex)

  const metricRegex = new RegExp(`^(?:${metricPattern})$`, 'i')

  return splitParts.map((part, i) => {
    if (terms.has(part.toLowerCase()) || metricRegex.test(part)) {
      return <strong key={i}>{part}</strong>
    }
    return part
  })
}
</file>

