const docColumns: Column<DocumentUploadResponse>[] = [
  {
    key: 'originalName',
    header: 'File Name',
  },
  {
    key: 'documentType',
    header: 'Type',
    width: '150px',
    render: (val) => (
      <Badge variant={val === 'RESUME' ? 'default' : 'secondary'}>
        {val === 'RESUME' ? 'Resume' : 'Cover Letter'}
