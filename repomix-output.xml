import type { ParsedItem, ParsedResumeGroup } from '@/types/resume'

export const categoryLabels: Record<string, string> = {
  PERSONAL_INFO: 'Personal Info',
  SUMMARY: 'Summary',
  EDUCATION: 'Education',
  EXPERIENCE: 'Work Experience',
  PROJECT: 'Projects',
  SKILL: 'Technical Skills',
  CERTIFICATION: 'Certifications',
}

export const categoryOrder = [
  'PERSONAL_INFO', 'SUMMARY', 'EDUCATION', 'EXPERIENCE',
  'PROJECT', 'SKILL', 'CERTIFICATION',
]

function groupByContext(items: ParsedItem[]): Map<string, ParsedItem[]> {
  const map = new Map<string, ParsedItem[]>()
  for (const item of items) {
    const key = item.context || ''
    if (!map.has(key)) map.set(key, [])
    map.get(key)!.push(item)
  }
  return map
}

function renderCategory(category: string, items: ParsedItem[]) {
  if (items.length === 0) return null

  switch (category) {
    case 'PERSONAL_INFO':
      return (
        <dl className="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
          {items.map((item) => (
            <div key={item.id} className="contents">
              <dt className="font-medium text-muted-foreground">{item.context}</dt>
              <dd>{item.content}</dd>
            </div>
          ))}
        </dl>
      )

    case 'SUMMARY':
    case 'CERTIFICATION':
      return (
        <ul className="space-y-1 list-disc pl-5 text-sm">
          {items.map((item) => (
            <li key={item.id}>{item.content}</li>
          ))}
        </ul>
      )

    case 'SKILL': {
      const grouped = groupByContext(items)
      return (
        <div className="space-y-1 text-sm">
          {Array.from(grouped.entries()).map(([context, groupItems]) => (
            <div key={context}>
              <span className="font-semibold">{context}: </span>
              <span>{groupItems.map((i) => i.content).join(', ')}</span>
            </div>
          ))}
        </div>
      )
    }

    case 'EXPERIENCE':
    case 'PROJECT':
    case 'EDUCATION': {
      const grouped = groupByContext(items)
      return (
        <div className="space-y-3 text-sm">
          {Array.from(grouped.entries()).map(([context, groupItems]) => (
            <div key={context}>
              <h5 className="text-sm font-semibold mb-1">{context}</h5>
              <ul className="space-y-1 list-disc pl-5">
                {groupItems.map((item) => (
                  <li key={item.id}>{item.content}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }

    default:
      return (
        <ul className="space-y-1 list-disc pl-5 text-sm">
          {items.map((item) => (
            <li key={item.id}>{item.content}</li>
          ))}
        </ul>
      )
  }
}

// Renders all categories for a single parsed resume group
export function renderResumeGroup(group: ParsedResumeGroup) {
  const byCategory = new Map<string, ParsedItem[]>()
  for (const item of group.items) {
    if (!byCategory.has(item.category)) byCategory.set(item.category, [])
    byCategory.get(item.category)!.push(item)
  }

  return (
    <div className="space-y-5 py-2">
      {categoryOrder
        .filter((cat) => byCategory.has(cat))
        .map((cat) => (
          <div key={cat}>
            <h5 className="text-sm font-semibold mb-2">
              {categoryLabels[cat] ?? cat}
            </h5>
            {renderCategory(cat, byCategory.get(cat)!)}
          </div>
        ))}
    </div>
  )
}
