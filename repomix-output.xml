import { useState, useEffect, useMemo } from 'react'
import { useParams } from 'react-router-dom'
import { toast } from 'sonner'
import { ResumePaperView } from '@/components/resume/resume-paper-view'
import { ResumeLineDetailsSheet } from '@/components/resume/resume-line-details-sheet'
import { ResumeDownloadButton } from '@/components/shared/resume-download-button'
import { LoadingSpinner } from '@/components/shared/loading-spinner'
import { sectionOrder, parseSubSection, parseDateForSort } from '@/components/resume/resume-utils'
import type { GroupedSection } from '@/components/resume/resume-utils'
import { getGeneratedResume, updateResumeLine } from '../api/resumeApi'
import type { GeneratedResumeResponse, ResumeLineOutput } from '../types/resume'

export default function ResumeReviewPage() {
  const { generatedResumeId } = useParams<{ generatedResumeId: string }>()
  const [resume, setResume] = useState<GeneratedResumeResponse | null>(null)
  const [loading, setLoading] = useState(true)
  const [selectedLine, setSelectedLine] = useState<ResumeLineOutput | null>(null)

  useEffect(() => { loadResume() }, [])

  const loadResume = async () => {
    try {
      const data = await getGeneratedResume(Number(generatedResumeId))
      setResume(data)
    } catch {
      toast.error('Failed to load resume')
    } finally {
      setLoading(false)
    }
  }

  const handleLineEdit = async (lineId: number, newContent: string) => {
    try {
      const updated = await updateResumeLine(Number(generatedResumeId), lineId, newContent)
      setResume(prev => {
        if (!prev) return prev
        return { ...prev, lines: prev.lines.map(l => l.id === lineId ? { ...l, content: updated.content } : l) }
      })
      if (selectedLine?.id === lineId) {
        setSelectedLine(prev => prev ? { ...prev, content: updated.content } : prev)
      }
    } catch {
      toast.error('Failed to update line')
    }
  }

  const techTerms: Set<string> = useMemo(() => {
    if (!resume) return new Set()
    const terms = new Set<string>()
    resume.lines.filter(l => l.section === 'SKILLS').forEach(l => {
      l.content.split(',').forEach(skill => {
        const trimmed = skill.trim()
        if (trimmed) terms.add(trimmed.toLowerCase())
      })
    })
    return terms
  }, [resume])

  const groupedSections: GroupedSection[] = useMemo(() => {
    if (!resume) return []
    return sectionOrder
      .map(section => {
        const sectionLines = resume.lines.filter(l => l.section === section)
        if (sectionLines.length === 0) return null
        const subGroupMap = new Map<string, ResumeLineOutput[]>()
        for (const line of sectionLines) {
          const key = line.subSection || '__none__'
          if (!subGroupMap.has(key)) subGroupMap.set(key, [])
          subGroupMap.get(key)!.push(line)
        }
        const subGroups = Array.from(subGroupMap.entries()).map(([key, lines]) => ({
          subSection: key === '__none__' ? null : key,
          parsed: parseSubSection(key === '__none__' ? null : key),
          lines,
        }))
        if (section === 'EXPERIENCE' || section === 'PROJECTS') {
          subGroups.sort((a, b) => parseDateForSort(b.parsed.date) - parseDateForSort(a.parsed.date))
        }
        return { section, subGroups }
      })
      .filter((g): g is GroupedSection => g !== null)
  }, [resume])

  if (loading) return <LoadingSpinner label="Loading resume..." />
  if (!resume) return null

  return (
    <div>
      <ResumePaperView
        resume={resume}
        groupedSections={groupedSections}
        selectedLine={selectedLine}
        onLineClick={setSelectedLine}
        onLineEdit={handleLineEdit}
        techTerms={techTerms}
      />
      <div className="mt-6 flex justify-center">
        <ResumeDownloadButton
          targetSelector=".resume-paper"
          fileName={`${resume.personalInfo?.fullName ?? resume.title ?? 'resume'}.pdf`}
        />
      </div>
      <ResumeLineDetailsSheet
        line={selectedLine}
        open={!!selectedLine}
        onClose={() => setSelectedLine(null)}
      />
    </div>
  )
}
</file>

